- note = cohort_client_note

- if note.note.length > 19
  %p{data: { 'bs-toggle' => 'popover', 'bs-placement' => 'bottom', 'bs-content' => note.note, 'bs-trigger' => 'hover', 'bs-container' => 'body'}}
    = truncate(note.note, length: 20)
- else
  = note.note

%p.attribution
  = note.user.name
  on
  = note.updated_at.to_date
