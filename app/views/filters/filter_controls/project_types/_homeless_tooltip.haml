:ruby
  names = HudHelper.util.homeless_project_types.map do |id|
    name = HudHelper.util.project_type(id)
  end.sort
  items = names.map do |name|
    "<li class='list-inline-item chip-v1-prs1'>#{CGI.escapeHTML name}</li>"
  end
  content = %Q{<p><ul class="list-inline d-inline mt-4">#{items.join.html_safe}</ul></p>}

%i.icon-info{tabindex: 0, data: { 'bs-toggle' => :popover, 'bs-title' => "Project Types classified as Homeless", 'bs-trigger' => :focus, 'bs-content' => content, 'bs-html' => :true }}
