wb = xlsx_package.workbook
wb.add_worksheet(name: 'Census Details') do |sheet|
  title = sheet.styles.add_style(sz: 12, b: true, alignment: {horizontal: :center})
  sheet.add_row(['Warehouse Client ID','First Name', 'Last Name', 'Project', 'Data Source', 'Date'], :style => title)
  @clients.each do |client|
    policy = current_user.reporting_policy_for_project(project_id: client['project_id'], mode: :download, client_id: client['client_id'])
    pii = GrdaWarehouse::PiiProvider.from_attributes(policy: policy, first_name: client['FirstName'], last_name: client['LastName'])
    sheet.add_row [
      client['client_id'],
      pii.first_name,
      pii.last_name,
      client['ProjectName'],
      client['short_name'],
      @date
    ]
  end
end