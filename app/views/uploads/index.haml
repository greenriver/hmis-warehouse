= render 'breadcrumbs'
.row
  .col-sm-8
    %h1 Uploads
  .col-sm-4
    - if @data_source.importable_by?(current_user)
      .pull-right
        = link_to new_data_source_upload_path, class: 'btn btn-primary pull-right mb-4' do
          %span.icon-plus
          Upload HUD CSV

- if @pagy.count.positive?
  = render 'common/pagination_top', item_name: 'upload'
  .table-responsive
    %table.table.table-striped
      %thead
        %tr
          %th Filename
          %th Uploaded By
          %th Uploaded On
          %th Processing Started
          %th Completed In
        %tbody
          - @uploads.each do |upload|
            %tr
              %td
                = upload.hmis_zip.filename
                - if upload.source_id_overridden?
                  %span.badge.badge-warning{ title: "Expected SourceID #{upload.export_source_expected_id.presence || '(none)'}, file had #{upload.export_source_file_id.presence || '(blank)'}" } SourceID overridden
                - elsif upload.awaiting_confirmation?
                  %span.badge.badge-secondary{ title: 'Uploaded but never confirmed, so it was never queued' } Not confirmed
              %td= upload.user&.name
              %td= upload.created_at
              %td= upload&.import_log&.loader_log&.started_at
              %td
                - if upload.import_log.present? && upload.import_log.loader_log_id.present?
                  = link_to upload.import_time, import_path(id: upload.import_log.id)
                - else
                  = upload.import_time
                  - if upload&.hmis_zip&.present? || upload.import_time == 'failed'
                    %br
                    = link_to 'Download Original', download_upload_import_path(upload)
  = render 'common/pagination_bottom', item_name: 'upload'
- else
  .none-found No uploads.
