= render 'breadcrumbs'
%h1
  Confirm upload for
  = @data_source.short_name

.row
  .col-sm-10
    .alert.alert-warning
      %p
        The SourceID in this file could not be matched against the SourceID configured on this data source.
        Review the details below before continuing. Uploading a data set for the wrong CoC or customer is difficult to unwind.
      - if @export_source.error == :unverifiable
        %p
          The SourceID could not be read from this file here. It will still be compared once the
          import expands the file, and the import will fail if it does not match.

    %table.table.table-striped
      %tbody
        %tr
          %th Filename
          %td= @upload.hmis_zip.filename
        %tr
          %th Expected SourceID (from the data source)
          %td= @data_source.source_id.presence || '(none configured)'
        %tr
          %th Observed SourceID (from Export.csv)
          %td= @export_source.source_id.presence || '(blank)'
        %tr
          %th SourceName (from Export.csv)
          %td= @export_source.source_name.presence || '(blank)'
        %tr
          %th Export date range
          %td
            - if @export_source.export_start_date.present? || @export_source.export_end_date.present?
              = [@export_source.export_start_date, @export_source.export_end_date].map { |d| d&.to_fs(:default) || '?' }.join(' to ')
            - else
              (unknown)

    = form_tag confirm_data_source_upload_path(@data_source, @upload) do
      = hidden_field_tag 'grda_warehouse_upload[dry_run]', @dry_run ? '1' : '0'
      .mb-4
        %label
          = check_box_tag :acknowledge, '1'
          I have reviewed the details above and want to import this file into
          %strong= @data_source.short_name
      .form-actions
        = submit_tag 'Confirm and Import', class: 'btn btn-primary'
        = link_to 'Cancel', data_source_uploads_path(@data_source), class: 'btn btn-secondary'
