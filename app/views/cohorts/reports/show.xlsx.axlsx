wb = xlsx_package.workbook
wb.add_worksheet(name: "Changes to #{@cohort.sanitized_name}".slice(0,30)) do |sheet|
  sheet.add_row(
    [
      "Changes between #{@range.range}",
    ]
  )
  sheet.merge_cells("A1:C1")

  title = sheet.styles.add_style(sz: 12, b: true, alignment: {horizontal: :center})
  sheet.add_row(
    [
      'Warehouse Client ID',
      'Client',
      'Change',
      'Reason',
      'Changed On',
      'Changed By',
    ],
    style: title
  )
  @changes.each do |change|
    next unless change.cohort_client.present? && change.cohort_client.client.present?
    sheet.add_row(
      [
        change.cohort_client.client.id,
        change.cohort_client.pii_provider(user: current_user, mode: :download).full_name,
        change.change,
        change.reason,
        change.changed_at.to_date,
        change.user.name,
      ]
    )
  end
end
