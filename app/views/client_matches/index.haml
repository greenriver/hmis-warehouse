= render '/clients/breadcrumbs'
- content_for :title, "Match Similar Clients"
- content_for :page_js do
  %script{ nonce: content_security_policy_nonce }
    :plain
      jQuery(function($) {
        $(document).on("ajax:success", function (e, data, status, xhr) {
          if (data.status == $('.client-match-tabs').data('status')) return;
          var cards = $('.client-match[data-id='+data.id+']');
          var rows = cards.closest('.merge-row');
          cards.fadeOut(100, function() {
            cards.remove();
            rows.each(function() {
              var row = $(this);
              if (row.find('.client-match').length == 0) {
                row.remove();
              }
            });
          });

          var viewed_badge = $('.badge[data-status='+$('.client-match-tabs').data('status')+']');
          var result_badge = $('.badge[data-status='+data.status+']');
          [[viewed_badge, -1], [result_badge, 1]].forEach(function(pair) {
            var badge = pair[0];
            var count = (parseInt(badge.attr('data-count')) || 0) + pair[1];
            badge.attr('data-count', count).html(count.toLocaleString('en-US')).toggleClass('d-none', count <= 0);
          });
        });
        $(document).on("ajax:error", function (e, xhr, status, error) {
          if (xhr.status == 409) {
            alert('Another user changed this match. Reload the page to see its current status.');
          } else {
            alert(error);
          }
        });
      })

%h1= content_for :title
%ul.nav.nav-tabs.client-match-tabs{ data: { status: @status } }
  - @possible_statuses.each do |label, status|
    %li.nav-item{class:('active' if status == @status)}
      = link_to url_for({status: status}), class: 'nav-link' do
        = label
        - count = @counts[status].to_i
        %span.badge.text-bg-primary{ class: ('d-none' if count <= 0), data: { status: status, count: count } }= number_with_delimiter(count)
- if @counts_include_hidden_matches
  %p.client-match-count-note.text-muted.mt-2 Counts include matches for clients you may not have access to.
- if @matches.empty?
  .none-found There are no #{@status} client matches at this time.

- @matches.group_by{|m| m.destination_client}.each do |dest, matches|
  .merge-row
    %h4
      - next unless dest
      - pii = dest.pii_provider(user: current_user)
      = pii.full_name
      - id = dest.id
      - id = dest.destination_client.id if dest.source?
      = link_to appropriate_client_path(id) do
        %span{data: { 'bs-toggle' => :tooltip, 'bs-title' => "Warehouse record for #{pii.full_name}."}}
          = "ID:#{id}"
      %span{style: 'font-weight: normal;'}
      = "SSN: #{pii.ssn}"
      = "DOB: #{pii.dob_and_age}"
    .merge-cards
      - matches.each do |match|
        .slab.merge-card
          = render match
- if @pagy.prev || @pagy.next
  .pagy-container.mt-4
    != pagy_bootstrap_nav(@pagy)
