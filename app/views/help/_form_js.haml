= content_for :page_js do
  %script{ nonce: content_security_policy_nonce }
    :plain
      $(document).ready(function() {
        $('.help-form').on('change', '.jSwitcher', function(e){
          if($('.jSwitcher').val() == 'internal'){
            $('.jInternal').show();
            $('.jExternal').hide();
          } else {
            $('.jInternal').hide();
            $('.jExternal').show();
          }
        });
        $('.jSwitcher').trigger('change');
      });