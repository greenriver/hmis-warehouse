- if lookup_context.exists?('homepage_content', ['root'], true)
  = render 'root/homepage_content'
- else
  - title = Translation.translate('Open Path HMIS Warehouse')

  - if !user_signed_in?
    .d-flex
      - if AuthMethod.devise?
        = render '/root/sign_in_form', title: title
      - elsif AuthMethod.jwt?
        = render '/root/jwt_sign_in_form', title: title
  -else
    %h1 Access Limited
    %p.alert.alert-info You do not have access to any data, please contact your administrator.
