- content_for :page_js do
  %script{ nonce: content_security_policy_nonce }
    :plain
      $(document).ready(function() {
        $('.jAgencyPatientReferrals').on('click', 'a[data-behavior="claim patient"]', function(e) {
          e.preventDefault();
          var value = $(this).data('value');
          var form = $(this).parents('form');
          var input = $(form).find("input[name='health_agency_patient_referral[claimed]']");
          $(input).val(value);
          $(form).submit();
        });
      });