= render 'breadcrumbs', data_source: @data_source
.mt-4
  %h1
    - if params[:coc_code] == 'unknown'
      = @coc_display_name
    - else
      = "#{params[:coc_code]} · #{@coc_display_name}"
  %p.text-muted
    = "#{pluralize(@coc_project_count, 'project')} across #{pluralize(@coc_org_count, 'organization')} in the CoC"
%div{ data: { controller: 'table-filter' } }
  = render 'project_filters', project_types: @coc_project_types
  .table-responsive
    = render 'organizations'
  .none-found.hide{ data: { 'table-filter-target' => 'noResults' } } No projects found.
