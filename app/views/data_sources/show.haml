- if @coc_display_name
  = render 'coc_scoped_detail'
- else
  = render 'breadcrumbs'
  .row.mb-4
    .col-sm-6
      %h1
        = @data_source.name
      %em.text-muted
        Data Source ID:
        %strong= @data_source.id
    .col-sm-6.text-right
  = render 'header_cards'
  - if @data_source.has_data?
    - if @coc_summaries
      = render 'coc_cards'
    - else
      .row.table-utilities
        .col-sm-12
          %h2
            = Translation.translate('Organizations')
            &amp;
            = Translation.translate('Projects')
      .table-responsive
        = render 'organizations'
