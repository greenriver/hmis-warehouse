.c-card--flush.mb-4
  %header.c-card__header.align-items-center
    .text-muted.text-uppercase.small.fw-bold.mb-1 Imports
    %h3.mb-0 Standard HUD imports
  .p-3
    %table.table.table-sm{style: 'table-layout: fixed; width: 100%;'}
      %tr
        %th Last Import Run
        %td
          = @data_source.last_imported_at
      - if @data_source.hmis?
        %tr
          %th Open Path HMIS URL
          %td
            %a{ href: @data_source.hmis_login_url(user: current_user), title: 'HMIS', target: '_blank', rel: 'noopener noreferrer' }
              = @data_source.hmis
              %span.pl-1.icon-link-ext
      %tr
        %th HUD CSV imports
        %td
          = checkmark_or_x(@data_source.importable?)
          - if @data_source.importable?
            Allowed
          - else
            Not allowed
          - if @data_source.importable? && @data_source.import_paused
            .label.label-info.ml-1
              import paused
    .pt-3
      - if @data_source.importable_by?(current_user)
        .d-block
          = link_to new_data_source_upload_path(@data_source), class: 'btn btn-sm btn-primary mr-2 mb-2' do
            Upload HUD HMIS CSV
      - if can_view_imports? && @data_source.uploads.any? && @data_source.directly_viewable_by?(current_user, permission: :can_view_imports) && can_upload_hud_zips?
        .d-block
          = link_to data_source_uploads_path(@data_source), class: 'btn btn-sm btn-secondary mr-2 mb-2' do
            View Uploads
      - if @data_source.importable_by?(current_user)
        .d-block
          = link_to hmis_csv_importer_data_source_import_overrides_path(data_source_id: @data_source), class: 'btn btn-sm btn-secondary mr-2 mb-2' do
            Manage Import Overrides
