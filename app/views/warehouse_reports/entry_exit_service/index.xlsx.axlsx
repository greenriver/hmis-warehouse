data_sources = GrdaWarehouse::DataSource.importable.index_by(&:id)
wb = xlsx_package.workbook
wb.add_worksheet(name: "Entry=Exit=Service") do |sheet|
  title = sheet.styles.add_style(sz: 12, b: true, alignment: {horizontal: :center})
  sheet.add_row(['Personal ID','First Name', 'Last Name', 'Entry Date', 'Exit Date',  'Date of Service', 'Project', 'Project ID', 'Project Type', 'Record Type', 'Data Source'], :style => title)
  @data.each do |client|
    uuid = if data_sources[client[:data_source_id]].munged_personal_id 
      GrdaWarehouse::Hud::Client.uuid client[:PersonalID]
    else
      client[:PersonalID]
    end
    policy = current_user.reporting_policy_for_project(project_id: client[:project_id], mode: :download, client_id: client[:destination_id])
    pii = GrdaWarehouse::PiiProvider.from_attributes(policy: policy, first_name: client[:FirstName], last_name: client[:LastName])
    sheet.add_row [
      uuid,
      pii.first_name,
      pii.last_name,
      client[:EntryDate],
      client[:ExitDate],
      client[:DateProvided],
      client[:project_name],
      client[:project_id],
      client[:project_type],
      client[:RecordType],
      data_sources[client[:data_source_id]].name
    ]
  end
end