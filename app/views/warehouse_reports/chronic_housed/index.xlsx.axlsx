wb = xlsx_package.workbook
wb.add_worksheet(name: 'Chronic Clients Housed') do |sheet|
  sheet.add_row(
    [
      'Warehouse Client ID',
      'First Name',
      'Last Name',
      'On Lists',
      'Housed On',
    ],
  )
  @clients.each do |_, exits|
    client = exits.first
    pii = @pii_providers[client.client_id]
    sheet.add_row(
      [
        client.client_id,
        pii.first_name,
        pii.last_name,
        @chronics[client.client_id].map(&:date).uniq.join('; '),
        exits.map { |ex| [ex.exit_date, HudHelper.util.destination(ex.destination)].join(' - ') }.uniq.join(';'),
      ],
    )
  end
end
