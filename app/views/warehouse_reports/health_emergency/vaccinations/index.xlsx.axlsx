wb = xlsx_package.workbook
wb.add_worksheet(name: "#{GrdaWarehouse::Config.current_health_emergency_title} Vaccinations") do |sheet|
  title = sheet.styles.add_style(sz: 12, b: true, alignment: {horizontal: :center})
  sheet.add_row(
    [
      "Showing clients present between #{@filter.start} and #{@filter.end} who were vaccinated",
    ], style: title,
  )
  sheet.merge_cells('A1:I1')
  sheet.add_row(
    [
      'Warehouse Client ID',
      'First Name',
      'Last Name',
      'DOB',
      'Vaccination dates',
      'Last Seen',
    ],
    style: title,
  )
  @clients.each do |client|
    pii = GrdaWarehouse::PiiProvider.new(client, policy: current_user.reporting_policy_for_client(client: client, mode: :download))
    served_on = client.date_of_last_service
    last_seen = client.last_projects_served_by.to_sentence
    last_seen += " #{served_on}" if served_on

    sheet.add_row(
      [
        client.id,
        pii.first_name,
        pii.last_name,
        GrdaWarehouse::PiiProvider.viewable_dob(client.DOB, policy: pii.policy),
        client.health_emergency_vaccinations.pluck(:vaccinated_on).join(', '),
        last_seen,
      ],
    )
  end
end
