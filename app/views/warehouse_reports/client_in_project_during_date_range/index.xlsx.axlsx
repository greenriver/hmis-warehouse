wb = xlsx_package.workbook
wb.add_worksheet(name: 'Enrolled Clients') do |sheet|
  title = sheet.styles.add_style(sz: 12, b: true, alignment: { horizontal: :center })
  sheet.add_row([
                  "Clients in #{@project.name(current_user)} between #{@start} and #{@end}",
                ])
  sheet.merge_cells('A1:F1')
  sheet.add_row([
                  'Warehouse Client ID',
                  'First Name',
                  'Last Name',
                  'DOB',
                  'Veteran Status',
                  "Cumulative Days Homeless as of #{Date.current}",
                  "Days Homeless in The Past Three Years as of #{Date.current}",
                ])
  @clients.each do |client|
    pii = GrdaWarehouse::PiiProvider.new(client, policy: current_user.reporting_policy_for_project(project_id: nil, mode: :download, client_id: client.id))
    sheet.add_row([
                    client.id,
                    pii.first_name,
                    pii.last_name,
                    GrdaWarehouse::PiiProvider.viewable_dob(client.DOB, policy: pii.policy),
                    HudHelper.util.veteran_status(client.VeteranStatus),
                    client.days_homeless,
                    client.days_homeless_in_last_three_years,
                  ])
  end
end
