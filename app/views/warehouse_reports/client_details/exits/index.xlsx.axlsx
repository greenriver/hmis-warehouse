wb = xlsx_package.workbook
wb.add_worksheet(name: "Exit Detail #{GrdaWarehouse::WarehouseReports::Dashboard::Base.available_sub_populations.invert[@filter.sub_population]}"[0..30]) do |sheet|
  title = sheet.styles.add_style(sz: 12, b: true, alignment: { horizontal: :center })
  sheet.add_row([
    'Warehouse Client ID',
    'First Name',
    'Last Name',
    'Date',
    'Destination',
    'Exit From',
  ] + GrdaWarehouse::Hud::Client.race_fields.map { |m| HudHelper.util.race(m).gsub('None', 'Race None') }, style: title)
  current_user.policy_context.preload_project_dependencies(@report.clients.map { |e| e.project.id })
  @report.clients.each do |enrollment|
    client = enrollment.client
    pii = client.project_pii_provider(project: enrollment.project, user: current_user, mode: :download)
    row = [
      enrollment.client_id,
      pii.first_name,
      pii.last_name,
      enrollment.last_date_in_program,
      enrollment.destination,
      enrollment.project.name(current_user),
    ] + GrdaWarehouse::Hud::Client.race_fields.map { |m| HudHelper.util.no_yes_reasons_for_missing_data(client[m.to_sym]&.to_i) }
    sheet.add_row(row)
  end
end
