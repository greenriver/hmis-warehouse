- title = "Active #{GrdaWarehouse::WarehouseReports::Dashboard::Base.available_sub_populations.invert[@filter.sub_population]} Detail"
- content_for :title, title
= render '/warehouse_reports/breadcrumbs'
.row
  .col-sm-8
    %h1= title
= render 'filter'

.row.mb-5
  .col-8
    %p
      This report was built to provide supporting details to the "Active Clients" section of the Population Dashboards.
  - if can_view_clients?
    .col-4.text-right
      = render 'report_downloads/report_download', export: @pdf_export, excel_export: @excel_export, excel_download_path: nil, excel_download_tooltip: 'Download includes the following additional fields: Length of Stay (to-date), Living Situation, Destination, Race.'

= render 'background_render', url: render_section_warehouse_reports_client_details_actives_path, fetch_params: { filter: @filter.for_params[:filters], page: params[:page] } do
  .rollup
    .rollup-container.well
= render 'common/section_not_loading', path_to_section: section_warehouse_reports_client_details_actives_path(link_params)
