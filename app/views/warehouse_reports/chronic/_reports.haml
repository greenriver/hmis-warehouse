- @job_reports.each do |run_at, report|
  %tr{class: 'jIncompleteReport'}
    %td= run_at
    %td= render 'spinner'
    %td= render 'parameters', report: report
- @reports.each do |report|
  %tr
    %td
      = report.started_at
    %td
      = link_to warehouse_reports_chronic_path(report) do
        = report.client_count
        clients
    %td= render 'parameters', report: report
    %td
      = link_to warehouse_reports_chronic_path(report), method: :delete, class: 'btn btn-sm btn-danger btn-icon-only', data: {confirm: "Are you sure you want to delete this chronic report?"} do
        %i.icon-cross
