wb = xlsx_package.workbook
wb.add_worksheet(name: 'Non-Alpha Names') do |sheet|
  title = sheet.styles.add_style(sz: 12, b: true, alignment: { horizontal: :center })
  sheet.add_row(['Personal ID', 'First Name', 'Last Name', 'Data Source'], style: title)
  @clients.each do |client|
    pii = GrdaWarehouse::PiiProvider.new(client, policy: current_user.reporting_policy_for_client(client: client, mode: :download))
    sheet.add_row [client.uuid, pii.first_name, pii.last_name, client.source_clients.map { |m| m.data_source&.short_name }.uniq.join(', ')]
  end
end
