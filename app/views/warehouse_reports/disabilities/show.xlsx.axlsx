wb = xlsx_package.workbook
wb.add_worksheet(name: 'Clients with Disabilities') do |sheet|
  title = sheet.styles.add_style(sz: 12, b: true, alignment: { horizontal: :center })
  sheet.add_row(
    [
      'Warehouse Client ID',
      'First Name',
      'Last Name',
      'Age',
      'Unaccompanied?',
      'Parenting?',
      'Head of Household?',
      'Veteran',
      'Disability & Response',
    ],
    style: title,
  )
  @clients.each do |client|
    disabilities = client['disabilities'].join(', ')
    enrollment = client['enrollment']
    policy = current_user.reporting_policy_for_project(project_id: nil, mode: :download, client_id: client['id'])
    pii = GrdaWarehouse::PiiProvider.from_attributes(policy: policy, first_name: client['FirstName'], last_name: client['LastName'])
    sheet.add_row [
      client['id'],
      pii.first_name,
      pii.last_name,
      enrollment&.[]('age'),
      yes_no(enrollment&.[]('unaccompanied_youth')),
      yes_no(enrollment&.[]('parenting_youth') || enrollment&.[]('parenting_juvenile')),
      yes_no(enrollment&.[]('head_of_household')),
      HudHelper.util.veteran_status(client['VeteranStatus']),
      disabilities,
    ]
  end
end
