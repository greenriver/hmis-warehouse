wb = xlsx_package.workbook

wb.add_worksheet(name: 'Active Veterans') do |sheet|
  title = sheet.styles.add_style(sz: 12, b: true, alignment: { horizontal: :center })

  sheet.add_row(
    [
      'Warehouse Client ID',
      'First Name',
      'Last Name',
      'DOB / Age',
      'SSN',
      'Veteran in',
      'First Date Homeless',
      'Number of enrollments',
      'Data Source',
      'Project Type',
      'Project',
      'Entry',
      'Exit',
    ],
    style: title,
  )

  @clients.each do |client|
    policy = current_user.reporting_policy_for_client(client: @clients_by_id[client['id']], mode: :download)
    pii = GrdaWarehouse::PiiProvider.from_attributes(policy: policy, first_name: client['FirstName'], last_name: client['LastName'], dob: client['DOB']&.to_date, ssn: client['SSN'])
    row = [
      client['id'],
      pii.first_name,
      pii.last_name,
      pii.dob_or_age,
      pii.ssn,
      client['data_sources'].join(', '),
      client['first_date_served'],
      client['enrollments']&.size,
    ]
    client['enrollments'].each do |enrollment|
      row += [
        enrollment['ds_short_name'],
        HudHelper.util.project_type_brief(enrollment['project_type']),
        enrollment['project_name'],
        enrollment['first_date_in_program'],
        enrollment['last_date_in_program'],
      ]
    end
    sheet.add_row(row)
  end
end
