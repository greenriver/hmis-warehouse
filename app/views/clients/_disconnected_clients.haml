%h3.mt-4 Disconnected Clients
%p
  Other clients that this client was either split from, or split into:
.row
  .col-sm-6
    %h4 Client Split From
    .card
      %table.table
        - split_froms = @client.splits_from
        - if split_froms.any?{ |split| split.source_client }
          %thead
            %th Name
            %th DOB
            %th SSN
            %th Split
            %th Split By
          %tbody
            - split_froms.each do |split|
              - c = split.source_client
              = debug c
              - if c
                - pii = c.pii_provider(user: current_user)
                %tr
                  %td= link_to pii.full_name, edit_client_path(c)
                  %td= pii.dob_or_age
                  %td= pii.ssn
                  %td= @client.warehouse_client_destination.last.reviewed_at
                  %td
                    - reviewer_id = @client.warehouse_client_destination.last.reviewd_by.to_i
                    - if reviewer_id != 0 && user = User.find(reviewer_id)
                      = user.name
        - else
          %tr
            %td None.
  .col-sm-6
    %h4 Client Split Into
    .card
      %table.table
        - split_into = @client.splits_to
        - if split_into.any?
          %thead
            %th Name
            %th DOB
            %th SSN
            %th Split
            %th Split By
          %tbody
            - split_into.each do |split|
              - c = split.destination_client
              - if c
                - pii = c.pii_provider(user: current_user)
                %tr
                  %td= link_to pii.full_name, edit_client_path(c)
                  %td= pii.dob_or_age
                  %td= pii.ssn
                  %td= c.warehouse_client_destination.first.reviewed_at
                  %td
                    - reviewer_id = @client.warehouse_client_destination.last.reviewd_by.to_i
                    - if reviewer_id != 0 && user = User.find(reviewer_id)
                      = user.name
        - else
          %tr
            %td None.
