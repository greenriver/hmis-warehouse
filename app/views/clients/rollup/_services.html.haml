= cache(['clients', 'services', @client, can_view_confidential_project_names?, controller_path, current_user], expires_in: GrdaWarehouse::Hud::Client::CACHE_EXPIRY) do
  - services = @client.source_enrollment_services.merge(GrdaWarehouse::Hud::Enrollment.visible_to(current_user))
  - st = services.arel_table
  - counts_by_year = services.bed_night.uniqueness_constraint.group(dp( services, 'year', st[:DateProvided] ).to_sql).count.sort_by(&:first).reverse
  - counts = counts_by_year.map(&:last)
  - dots = { min: counts.min, max: counts.max, points: counts } if counts.uniq.many?

  %table.table{ data: ({ controller: 'service-dots', service_dots_dots_value: dots.to_json } if dots) }
    %colgroup
      %col
      %col(style="width:6.5em;")
      %col(style="width:12px;")
    %thead
      %tr
        %th Year of Service Start
        %th Bed Starts
        %th
    %tbody
      - counts_by_year.each do |year, count|
        %tr
          %td= year.to_i
          %td.num-cell= count
          %td.dot{ data: { service_dots_target: 'dot' } }
