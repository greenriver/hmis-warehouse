- demographic_columns = GrdaWarehouse::ClientDemographicColumns.visible
= cache(['clients', 'demographics', @client, controller_path, current_user, current_user.load_effective_permissions, demographic_columns.map { |column| column[:key] }], expires_in: GrdaWarehouse::Hud::Client::CACHE_EXPIRY) do
  - authoritative_data_source_ids = GrdaWarehouse::DataSource.authoritative.pluck(:id)
  - source_clients = @client.source_clients.source_visible_to(current_user, client_ids: @client.source_client_ids)
  - pii = @client.pii_provider(user: current_user)
  %table.table
    %thead
      %tr
        %th ID
        - demographic_columns.each do |column|
          %th{style: column[:width] ? "width: #{column[:width]};" : nil}
            %span{data: { 'bs-toggle' => :tooltip, 'bs-title' => @client.demographic_calculation_logic_description(column[:tooltip])}}= column[:label]
        %th
        %th
    %tbody
      %tr
        %td.destination-data-source-tag{data: { 'bs-toggle' => :tooltip, 'bs-title' => 'Data from this row is used in reporting.', container: 'body'}}
          .destination-sqr Warehouse
        - demographic_columns.each do |column|
          %td= GrdaWarehouse::ClientDemographicColumns.value_for(column[:key], client: @client, pii: pii)
        %td{colspan: 2}

      - source_clients.joins(:data_source).preload(:data_source).each do |client|
        = render 'clients/demographic_row', client: client, authoritative_data_source_ids: authoritative_data_source_ids, demographic_columns: demographic_columns


:css
  .client-name .tooltip-inner {
    max-width: 300px;
  }
  .client-name .tooltip.in {
    opacity: 1;
  }
