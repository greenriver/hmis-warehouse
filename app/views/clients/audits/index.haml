- title = "Access History"
- content_for :title, title
= render 'clients/breadcrumbs'

= render 'clients/aliases'
= render 'clients/tab_navigation', current: client_audits_path(@client)

%h1=content_for :title
- if @pagy.count.positive?
  = render 'common/pagination_top', item_name: 'log'
  .table-responsive
    %table.table.table-striped
      %thead
        %tr
          %th Date
          %th User
          %th Action
          %th Item
      %tbody
        - @audit_log.each do |item|
          - title = audit_item_title(item)
          %tr
            %td= item.created_at
            %td= link_to item.user.name, edit_admin_user_path(item.user.id)
            %td
              - tooltip = "Method: #{item.method}"
              %span.action{data: { 'bs-toggle' => :tooltip, 'bs-title' => tooltip}}
                = item.action_name

            %td= link_to title, item.path
  = render 'common/pagination_bottom', item_name: 'log'
- else
  .none-found No access history

- if @restriction_versions.any?
  %h2.mt-4 Restriction History
  .table-responsive
    %table.table.table-striped#restriction-history
      %thead
        %tr
          %th Date
          %th User
          %th Change
          %th Source
      %tbody
        - @restriction_versions.each do |version|
          - actor = @restriction_users[version.clean_user_id.to_i]
          %tr
            %td= version.created_at
            %td= actor&.name || 'Unknown'
            %td= version.event == 'destroy' ? 'Restricted: Yes → No' : 'Restricted: No → Yes'
            %td= version.client_id == @client.id ? 'Warehouse' : 'HMIS'
