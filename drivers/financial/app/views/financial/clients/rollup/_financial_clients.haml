:ruby
  clients = @client.
    financial_clients.
    order(client_last_name: :asc, client_first_name: :asc, created_at: :asc)
- if clients.any?
  - policy = @client.pii_provider(user: current_user).policy
  .table-responsive
    %table.table
      %thead
        %tr
          %th Name
          %th HoH?
          %th Referral to Agency Date
          %th Referral to WIT
          %th Lease Start Date
          %th Created
          %th Updated
      %tbody
        - clients.each do |client|
          - pii = GrdaWarehouse::PiiProvider.from_attributes(policy: policy, first_name: client.client_first_name, last_name: client.client_last_name)
          %tr
            %td= pii.full_name
            %td= yes_no(client.head_of_household == 1)
            %td.date-cell= client.date_of_referral_to_agency&.to_date
            %td.date-cell= client.date_of_referral_to_wit&.to_date
            %td.date-cell= client.lease_start_date&.to_date
            %td= client.created_at
            %td= client.updated_at

- else
  .no-data
    No Financial Clients on Record
