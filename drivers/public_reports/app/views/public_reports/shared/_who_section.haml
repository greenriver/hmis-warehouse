- include_breakdown = local_assigns.fetch(:include_breakdown, true)
- current_index = who['currentIndex']
- current_period_label = who['periods'][current_index]
- all_people = who['donuts']['all-people']
- veterans = who['donuts']['veterans']
- household_type = who['donuts']['household-type']

%div{ data: { component: 'who-section' } }
  .who-controls
    %label.who-controls__field
      %span Choose time period
      = render 'public_reports/shared/period_select', periods: who['periods'], current_index: current_index, data_attr: 'who-period', id: 'who-period-select'
  %p.who-controls__hint Select a time period; this selection affects all charts below.
  %p.visually-hidden{ role: 'status', 'aria-live' => 'polite', data: { 'who-period-status' => true } }

  %h3.who-section-heading Population Sheltered vs. Unsheltered
  %p.who-controls__period-note
    Showing data for
    %strong{ data: { 'who-current-period' => true } }= current_period_label
    \—
    %a{ href: '#who-period-select' }
      change time period
      %span.visually-hidden for Population Sheltered vs. Unsheltered
  - who['periods'].each_index do |period_index|
    .chart-grid.chart-grid--2{ data: { 'who-period-pane' => period_index }, hidden: period_index != current_index }
      = render 'public_reports/shared/donut_chart', id: 'all-people', donut: all_people, period_index: period_index
      = render 'public_reports/shared/donut_chart', id: 'veterans', donut: veterans, period_index: period_index

  %h3.who-section-heading= household_type['title']
  %p.who-controls__period-note
    Showing data for
    %strong{ data: { 'who-current-period' => true } }= current_period_label
    \—
    %a{ href: '#who-period-select' }
      change time period
      %span.visually-hidden= " for #{household_type['title']}"
  - who['periods'].each_index do |period_index|
    %div{ data: { 'who-period-pane' => period_index }, hidden: period_index != current_index }
      = render 'public_reports/shared/composition_bar_chart', id: 'household-type', donut: household_type, period_index: period_index

  %h3.who-section-heading= Translation.translate('Racial Composition')
  %p.who-controls__period-note
    Showing data for
    %strong{ data: { 'who-current-period' => true } }= current_period_label
    \—
    %a{ href: '#who-period-select' }
      change time period
      %span.visually-hidden= " for #{Translation.translate('Racial Composition')}"
  - who['periods'].each_index do |period_index|
    %div{ data: { 'who-period-pane' => period_index }, hidden: period_index != current_index }
      = render 'public_reports/shared/race_bar_chart', race: who['race'], categories: who['raceTitleCategories'], period_index: period_index

  - if include_breakdown
    - default_grouping_label = who['breakdownGroupings']['household_type']['label']
    %h3.breakdown-heading= "#{default_grouping_label} breakdown"
    %p.who-controls__period-note
      Showing data for
      %strong{ data: { 'who-current-period' => true } }= current_period_label
      \—
      %a{ href: '#who-period-select' }
        change time period
        %span.visually-hidden= " for #{default_grouping_label} breakdown"
    .who-controls
      %label.who-controls__field
        %span Choose grouping
        %select{ data: { 'who-grouping' => true } }
          - who['breakdownGroupings'].each do |key, grouping|
            %option{ value: key, selected: key == 'household_type' }= grouping['label']

    %ul.chart-legend.breakdown-legend
      %li
        %span.swatch{ style: 'background:var(--color-sheltered)' }
        Sheltered
      %li
        %span.swatch{ style: 'background:var(--color-unsheltered)' }
        Unsheltered
      %li
        %span.swatch{ style: 'background:var(--color-redacted)' }
        Data suppressed (too few to report)
    %p.breakdown-chronic-info Chronically homeless people have been homeless for 12 months in the past 3 years and have a long-term disability.

    - who['periods'].each_index do |period_index|
      %div{ data: { 'who-period-pane' => period_index }, hidden: period_index != current_index }
        = render 'public_reports/shared/breakdown', breakdown: who['breakdown'], breakdown_groupings: who['breakdownGroupings'], period_index: period_index

  %script{ nonce: content_security_policy_nonce }= public_report_asset('who_page.js')
