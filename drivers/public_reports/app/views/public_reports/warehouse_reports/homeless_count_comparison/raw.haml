- data = JSON.parse(@report.precalculated_data)
- tile = { 'value' => number_to_percentage(data['count'], precision: 0), 'label' => @report.instance_title, 'class' => data['change_direction'] }
- note = "#{data['date_range']} compared to #{data['comparison_range']}"
= render 'public_reports/shared/kpi_tiles', tiles: [tile], note: note
