- if @report.renderable?
  - data = @report.parsed_pre_calculated_data
  - inflow_outflow = data['inflow_outflow']
  %section
    = render 'public_reports/shared/line_chart', chart: PublicReports::LineChart.new(labels: inflow_outflow['labels'], series: inflow_outflow['series']), title: Translation.translate('Total Number of People Entering and Exiting Homelessness'), colors: [@report.settings.color(1, :population), @report.settings.color(2, :population)]
    - if inflow_outflow['note']
      %p.chart-note= inflow_outflow['note']

    = render 'public_reports/shared/glossary'
- else
  = render 'public_reports/shared/stale'
