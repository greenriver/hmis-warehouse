- if @report.renderable?
  - data = @report.parsed_pre_calculated_data
  = render 'public_reports/shared/summary_section', data: data
  = render 'public_reports/shared/trends_section', data: data
  = render 'public_reports/shared/need_section', data: data
  = render 'public_reports/shared/population_section', who: data['who'], include_breakdown: true
  = render 'public_reports/shared/glossary'
  - if @report.completed_at
    %p.data-note= "Date published: #{@report.completed_at.to_date}"
- else
  = render 'public_reports/shared/stale'
