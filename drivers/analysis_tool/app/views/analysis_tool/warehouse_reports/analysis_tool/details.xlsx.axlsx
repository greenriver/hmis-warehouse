wb = xlsx_package.workbook

wb.add_worksheet(name: @report.support_title(params)[0..30]) do |sheet|
  title = sheet.styles.add_style(sz: 12, b: true, alignment: { horizontal: :center })
  row = [
    'Warehouse Client ID',
    'First Name',
    'Last Name',
    'DOB',
    'Gender',
    'Sex',
    'Veteran Status',
    'Race',
  ]
  sheet.add_row(row, style: title)
  clients = @report.support_for(params)
  clients.each do |client|
    pii = ::GrdaWarehouse::PiiProvider.new(client, policy: current_user.reporting_policy_for_client(client: client, mode: :download))
    row = [
      client.id,
      pii.first_name,
      pii.last_name,
      ::GrdaWarehouse::PiiProvider.viewable_dob(client.DOB, policy: pii.policy),
      client.gender,
      HudHelper.util.sex(client.Sex),
      HudHelper.util.no_yes_missing(client.VeteranStatus),
      client.race_description,
    ]
    sheet.add_row(row)
  end
end
