:ruby
  excel_type = 'ContinuumSemiAnnualPerformance::DocumentExports::ReportExcelExport'
  pdf_type = 'ContinuumSemiAnnualPerformance::DocumentExports::ReportPdfExport'
  excel_data = ->(tab) { { url: document_exports_path, type: excel_type, query_string: { id: @report.id, tab: tab }.to_query } }
  pdf_data = ->(tab) { { url: document_exports_path, type: pdf_type, query_string: { id: @report.id, tab: tab }.to_query } }
.dropdown.mb-3
  %button#downloadButton.btn.btn-secondary.dropdown-toggle{ aria: { expanded: 'false', haspopup: 'true' }, data: { 'bs-toggle' => 'dropdown' }, type: 'button' }
    %i.icon-download2
    Download Report
  .dropdown-menu.dropdown-menu-right.px-0.py-2{ aria: { labelledby: 'downloadButton' } }
    %a.dropdown-item.j-document-exports.py-2{ href: '#', data: excel_data.call(@tab) }
      Excel - #{tab_title(@tab)}
    %a.dropdown-item.j-document-exports.py-2{ href: '#', data: excel_data.call('all') }
      Excel - Full CoC
    %a.dropdown-item.j-document-exports.py-2{ href: '#', data: pdf_data.call(@tab) }
      PDF - #{tab_title(@tab)}
    %a.dropdown-item.j-document-exports.py-2{ href: '#', data: pdf_data.call('all') }
      PDF - Full CoC
    = link_to 'Recent Downloads', account_downloads_path, class: 'dropdown-item py-2'
