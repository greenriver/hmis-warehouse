{
  "item": [
    {
      "text": "Decision",
      "type": "CHOICE",
      "link_id": "review_decline_decision",
      "mapping": {
        "custom_field_key": "housing_workflow_coc_review_decline_decision"
      },
      "required": true,
      "component": "RADIO_BUTTONS",
      "pick_list_options": [
        { "code": "approve_decline", "label": "Approve decline" },
        { "code": "go_back", "label": "Send back to previous step" },
        { "code": "send_forward", "label": "Override decline and continue referral" }
      ]
    },
    {
      "text": "Approving the decline will close the referral, return the client to the Eligible Clients list, and make the unit available for new referrals.",
      "type": "DISPLAY",
      "link_id": "review_decline_message",
      "component": "ALERT_WARNING",
      "enable_when": [
        {
          "operator": "EQUAL",
          "question": "review_decline_decision",
          "answer_code": "approve_decline"
        }
      ],
      "enable_behavior": "ALL"
    },
    {
      "text": "The referral will return to the previous step. If it is declined again, it can no longer be sent back.",
      "type": "DISPLAY",
      "link_id": "review_decline_go_back_message",
      "component": "ALERT_INFO",
      "enable_when": [
        {
          "operator": "EQUAL",
          "question": "review_decline_decision",
          "answer_code": "go_back"
        }
      ],
      "enable_behavior": "ALL"
    },
    {
      "text": "The referral will advance to the next step.",
      "type": "DISPLAY",
      "link_id": "review_decline_send_forward_message",
      "component": "ALERT_INFO",
      "enable_when": [
        {
          "operator": "EQUAL",
          "question": "review_decline_decision",
          "answer_code": "send_forward"
        }
      ],
      "enable_behavior": "ALL"
    },
    {
      "text": "Referral Result",
      "type": "CHOICE",
      "link_id": "referral_result",
      "mapping": {
        "custom_field_key": "housing_workflow_coc_review_decline_referral_result"
      },
      "required": true,
      "component": "RADIO_BUTTONS",
      "pick_list_options": [
        { "code": "2", "label": "Unsuccessful referral: client rejected" },
        { "code": "3", "label": "Unsuccessful referral: provider rejected" }
      ],
      "enable_when": [
        {
          "operator": "EQUAL",
          "question": "review_decline_decision",
          "answer_code": "approve_decline"
        }
      ],
      "enable_behavior": "ALL"
    },
    {
      "text": "Notes",
      "type": "TEXT",
      "link_id": "notes",
      "mapping": {
        "custom_field_key": "housing_workflow_coc_review_decline_note"
      },
      "required": false
    }
  ]
}
