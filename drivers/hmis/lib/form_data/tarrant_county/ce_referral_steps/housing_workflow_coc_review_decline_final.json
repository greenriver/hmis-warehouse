{
  "item": [
    {
      "text": "This referral has already been sent back once, so it can no longer be sent back. You can approve the decline or override it and continue the referral.",
      "type": "DISPLAY",
      "link_id": "review_decline_final_message",
      "component": "ALERT_INFO"
    },
    {
      "text": "Decision",
      "type": "CHOICE",
      "link_id": "review_decline_final_decision",
      "mapping": {
        "custom_field_key": "housing_workflow_coc_review_decline_final_decision"
      },
      "required": true,
      "component": "RADIO_BUTTONS",
      "pick_list_options": [
        { "code": "approve_decline", "label": "Approve decline" },
        { "code": "send_forward", "label": "Override decline and continue referral" }
      ]
    },
    {
      "text": "Approving the decline will close the referral, return the client to the Eligible Clients list, and make the unit available for new referrals.",
      "type": "DISPLAY",
      "link_id": "review_decline_final_approve_message",
      "component": "ALERT_WARNING",
      "enable_when": [
        {
          "operator": "EQUAL",
          "question": "review_decline_final_decision",
          "answer_code": "approve_decline"
        }
      ],
      "enable_behavior": "ALL"
    },
    {
      "text": "Referral Result",
      "type": "CHOICE",
      "link_id": "referral_result",
      "mapping": {
        "custom_field_key": "housing_workflow_coc_review_decline_final_referral_result"
      },
      "required": true,
      "component": "RADIO_BUTTONS",
      "pick_list_options": [
        { "code": "2", "label": "Unsuccessful referral: client rejected" },
        { "code": "3", "label": "Unsuccessful referral: provider rejected" }
      ],
      "enable_when": [
        {
          "operator": "EQUAL",
          "question": "review_decline_final_decision",
          "answer_code": "approve_decline"
        }
      ],
      "enable_behavior": "ALL"
    },
    {
      "text": "Notes",
      "type": "TEXT",
      "link_id": "notes",
      "mapping": {
        "custom_field_key": "housing_workflow_coc_review_decline_final_note"
      },
      "required": false
    }
  ]
}
