[
  {
    "form_identifier": "base-intake",
    "append_items": [
      {
        "type": "GROUP",
        "link_id": "az_eviction",
        "text": "Eviction",
        "item": [
          {
            "type": "CHOICE",
            "link_id": "didyouexperienceanevi",
            "text": "Did you experience an eviction from housing in the last 12 months?",
            "required": false,
            "warn_if_empty": false,
            "mapping": {
              "custom_field_key": "mar_didyouexperienceanevi"
            },
            "pick_list_options": [
              {
                "code": "Yes"
              },
              {
                "code": "No"
              }
            ]
          },
          {
            "type": "CHOICE",
            "link_id": "ifyespleaseselectthet",
            "text": "IF YES, please select the type of eviction you experienced:",
            "brief_text": "Type of Eviction",
            "required": false,
            "warn_if_empty": false,
            "mapping": {
              "custom_field_key": "mar_ifyespleaseselectthet"
            },
            "enable_behavior": "ALL",
            "enable_when": [
              {
                "question": "didyouexperienceanevi",
                "operator": "EQUAL",
                "answer_code": "Yes"
              }
            ],
            "pick_list_options": [
              {
                "code": "Non-Payment of Rent (COVID-19 Hardship)"
              },
              {
                "code": "Non-Payment of Rent (Non-COVID-19 Related)"
              },
              {
                "code": "Other Issue (Non-Rent)"
              }
            ]
          }
        ]
      },
      {
        "type": "GROUP",
        "link_id": "az_move_in",
        "text": "Move-In",
        "data_collected_about": "HOH",
        "custom_rule": {
          "operator": "ANY",
          "parts": [
            {
              "_comment": "PSH",
              "variable": "projectType",
              "operator": "EQUAL",
              "value": 3
            },
            {
              "_comment": "RRH",
              "variable": "projectType",
              "operator": "EQUAL",
              "value": 13
            },
            {
              "_comment": "TH",
              "variable": "projectType",
              "operator": "EQUAL",
              "value": 2
            },
            {
              "_comment": "SSO",
              "variable": "projectType",
              "operator": "EQUAL",
              "value": 6
            },
            {
              "_comment": "HP",
              "variable": "projectType",
              "operator": "EQUAL",
              "value": 12
            }
          ]
        },
        "item": [
          {
            "type": "CHOICE",
            "link_id": "locationofhousingmove",
            "text": "Location of Housing Move-In",
            "required": false,
            "warn_if_empty": false,
            "mapping": {
              "record_type": "ENROLLMENT",
              "custom_field_key": "mar_locationofhousingmove"
            },
            "pick_list_options": [
              {
