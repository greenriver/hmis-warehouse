            "text": "Move-in Date",
            "mapping": {
              "record_type": "ENROLLMENT",
              "field_name": "moveInDate"
            },
            "bounds": [
              {
                "id": "min-date",
                "type": "MIN",
                "value_local_constant": "$entryDate"
              },
              {
                "id": "max-date",
                "type": "MAX",
                "value_local_constant": "$exitDate"
              },
              {
                "id": "max-future-date",
                "type": "MAX",
                "value_local_constant": "$today",
                "offset": 7
              }
            ]
          }
        ]
      }
    ]
