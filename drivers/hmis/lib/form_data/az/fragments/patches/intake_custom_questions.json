[
  {
    "link_id": "entry_date_group",
    "append_items": [
      {
        "type": "CHOICE",
        "link_id": "didyouexperienceanevi",
        "text": "Did you experience an eviction from housing in the last 12 months?",
        "brief_text": "Eviction in Last 12 Months",
        "required": false,
        "warn_if_empty": false,
        "mapping": {
          "record_type": "ENROLLMENT",
          "custom_field_key": "mar_didyouexperienceanevi"
        },
        "pick_list_options": [
          {
            "code": "Yes"
          },
          {
            "code": "No"
          }
        ]
      },
      {
        "type": "CHOICE",
        "link_id": "ifyespleaseselectthet",
        "text": "IF YES, please select the type of eviction you experienced:",
        "brief_text": "Type of Eviction",
        "required": false,
        "warn_if_empty": false,
        "mapping": {
          "record_type": "ENROLLMENT",
          "custom_field_key": "mar_ifyespleaseselectthet"
        },
        "enable_behavior": "ALL",
        "enable_when": [
          {
            "question": "didyouexperienceanevi",
            "operator": "EQUAL",
            "answer_code": "Yes"
          }
        ],
        "pick_list_options": [
          {
            "code": "Non-Payment of Rent (COVID-19 Hardship)"
          },
          {
            "code": "Non-Payment of Rent (Non-COVID-19 Related)"
          },
          {
            "code": "Other Issue (Non-Rent)"
          }
        ]
      }
    ]
  },
  {
    "form_identifier": "base-intake",
    "append_items": [
      {
        "type": "GROUP",
        "link_id": "az_path_smi",
        "text": "PATH SMI",
        "custom_rule": {
          "operator": "ANY",
          "parts": [
            {
              "_comment": "PATH",
              "variable": "projectFunderComponents",
              "operator": "INCLUDE",
              "value": "HHS: PATH"
            }
          ]
        },
        "item": [
          {
            "type": "CHOICE",
            "link_id": "clienthasbeensmideter",
            "text": "Client has been SMI Determined",
            "required": false,
            "warn_if_empty": false,
            "mapping": {
              "record_type": "ENROLLMENT",
              "custom_field_key": "mar_clienthasbeensmideter"
            },
            "pick_list_options": [
              {
                "code": "Yes"
              },
              {
                "code": "No"
              }
            ]
          },
          {
            "type": "DATE",
            "link_id": "ifyessmidetermineddat",
            "text": "If Yes SMI Determined, date of determination:",
            "brief_text": "SMI Determination Date",
            "required": false,
            "warn_if_empty": false,
            "mapping": {
              "record_type": "ENROLLMENT",
              "custom_field_key": "mar_ifyessmidetermineddat"
            },
            "enable_behavior": "ALL",
            "enable_when": [
              {
                "question": "clienthasbeensmideter",
                "operator": "EQUAL",
                "answer_code": "Yes"
              }
            ]
          },
          {
            "type": "CHOICE",
            "link_id": "ifnosmidetermineddidc",
            "text": "If No SMI Determined, did client appeal?",
            "brief_text": "SMI Appeal",
            "required": false,
            "warn_if_empty": false,
            "mapping": {
              "record_type": "ENROLLMENT",
              "custom_field_key": "mar_ifnosmidetermineddidc"
            },
            "enable_behavior": "ALL",
            "enable_when": [
              {
                "question": "clienthasbeensmideter",
                "operator": "EQUAL",
                "answer_code": "No"
              }
            ],
            "pick_list_options": [
              {
                "code": "Yes"
              },
              {
                "code": "No"
              }
            ]
          },
          {
            "type": "DATE",
            "link_id": "ifyesclientappealedda",
            "text": "If Yes client appealed, date of appeal:",
            "brief_text": "SMI Appeal Date",
            "required": false,
            "warn_if_empty": false,
            "mapping": {
              "record_type": "ENROLLMENT",
              "custom_field_key": "mar_ifyesclientappealedda"
            },
            "enable_behavior": "ALL",
            "enable_when": [
              {
                "question": "ifnosmidetermineddidc",
                "operator": "EQUAL",
                "answer_code": "Yes"
              }
            ]
          }
        ]
      }
