{
  "item": [
    {
      "type": "CHOICE",
      "link_id": "configType",
      "text": "Config Type",
      "pick_list_reference": "PROJECT_CONFIG_TYPES",
      "mapping": {
        "field_name": "configType"
      },
      "helper_text": "Select the type of configuration to create. Config type cannot be changed once set.",
      "component": "DROPDOWN",
      "required": true,
      "disabled_display": "PROTECTED_WITH_VALUE",
      "enable_behavior": "ALL",
      "enable_when": [
        {
          "local_constant": "$projectConfigId",
          "operator": "EXISTS",
          "answer_boolean": false,
          "_comment": "Only enable this question when creating a new project config"
        }
      ]
    },
    {
      "type": "CHOICE",
      "required": false,
      "link_id": "projectType",
      "text": "Project Type",
      "pick_list_reference": "ProjectType",
      "helper_text": "(Optional) Enable this configuration for all projects with the specified Project Type",
      "mapping": {
        "field_name": "projectType"
      }
    },
    {
      "type": "CHOICE",
      "required": false,
      "link_id": "projectId",
      "text": "Project",
      "pick_list_reference": "PROJECT",
      "helper_text": "(Optional) Enable this configuration in the specified Project",
      "mapping": {
        "field_name": "projectId"
      }
    },
    {
      "type": "CHOICE",
      "required": false,
      "link_id": "organizationId",
      "text": "Organization",
      "pick_list_reference": "ORGANIZATION",
      "helper_text": "(Optional) Enable this configuration in the specified Organization",
      "mapping": {
        "field_name": "organizationId"
      }
    },
    {
      "link_id": "lengthOfAbsenceDays",
      "required": true,
      "type": "INTEGER",
      "text": "Length of Absence (Days)",
      "mapping": {
        "field_name": "lengthOfAbsenceDays"
      },
      "enable_behavior": "ALL",
      "enable_when": [
        {
          "question": "configType",
          "operator": "EQUAL",
          "answer_code": "AUTO_EXIT"
        }
      ]
    },
    {
      "link_id": "receivesDirectReferrals",
      "required": true,
      "type": "BOOLEAN",
      "text": "Receives Direct Referrals",
      "mapping": {
        "field_name": "receivesDirectReferrals"
      },
      "enable_behavior": "ALL",
      "enable_when": [
        {
          "question": "configType",
          "operator": "EQUAL",
          "answer_code": "COORDINATED_ENTRY"
        }
      ]
    },
    {
      "link_id": "receivesDirectReferralsFrom",
      "required": false,
      "type": "CHOICE",
      "repeats": true,
      "text": "Receives direct referrals from",
      "helper_text": "(Optional) Limit which projects can send direct referrals to this project. Leave blank to accept direct referrals from all sending projects.",
      "pick_list_reference": "PROJECTS_SENDING_DIRECT_CE_REFERRALS",
      "mapping": {
        "field_name": "receivesDirectReferralsFrom"
      },
      "enable_behavior": "ALL",
      "enable_when": [
        {
          "question": "configType",
          "operator": "EQUAL",
          "answer_code": "COORDINATED_ENTRY"
        },
        {
          "question": "receivesDirectReferrals",
          "operator": "EQUAL",
          "answer_boolean": true
        }
      ]
    },
    {
      "link_id": "supportsWaitlistReferrals",
      "required": true,
      "type": "BOOLEAN",
      "text": "Supports Waitlist Referrals",
      "mapping": {
        "field_name": "supportsWaitlistReferrals"
      },
      "enable_behavior": "ALL",
      "enable_when": [
        {
          "question": "configType",
          "operator": "EQUAL",
          "answer_code": "COORDINATED_ENTRY"
        }
      ]
    }
  ]
}
