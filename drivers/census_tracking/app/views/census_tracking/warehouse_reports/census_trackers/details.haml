= content_for :crumbs do
  = link_to census_tracking_warehouse_reports_census_trackers_path(params: @filter.for_params) do
    = "« Census Tracker"
- title = [@project_name, @type, @key].compact.join(' - ')
- content_for :title, title
= content_for :modal_title, title

%table.table.table-sm
  %thead
    %tr
      - detail_columns.keys.each do |name|
        %th= name
  %tbody
    - @clients.each do |client|
      - pii = GrdaWarehouse::PiiProvider.from_attributes(policy: current_user.reporting_policy_for_project(project_id: @project_id, client_id: client.client_id), first_name: client.first_name, last_name: client.last_name)
      %tr
        - detail_columns.each do |key, field|
          - value = field.in?([:first_name, :last_name]) ? pii.public_send(field) : client.public_send(field)
          %td
            - if field == :client_id
              = link_to value, client_path(value)
            - else
              = value
