- title = 'User Access Summary'
- content_for :title, title

= render '/warehouse_reports/breadcrumbs', tab: 'audit'
%h1.mb-3= title
= render 'tabs'
= render 'date_range_filter', url: user_summary_access_logs_warehouse_reports_reports_path
- if @inline_html
  = @inline_html
- else
  = render 'background_render', url: render_user_summary_access_logs_warehouse_reports_reports_path, fetch_params: { filters: @filter.for_params[:filters] } do
    .rollup
      .rollup-container.well
