.card
  %table.table.table-striped
    %thead
      %tr
        %th Client
        %th Engagement Date
        %th Last Seen
    %tbody
      - @report.clients.each do |client|
        - pii = GrdaWarehouse::PiiProvider.from_attributes(policy: client[:pii_policy], first_name: client[:first_name], last_name: client[:last_name])
        %tr
          %td= link_to pii.brief_name, client_path(client[:id])
          %td= client[:engagement_date]
          %td= client[:last_seen] || client[:engagement_date]
